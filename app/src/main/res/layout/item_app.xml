<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout android:layout_width="44dp" android:layout_height="44dp"
        android:layout_marginEnd="12dp">
        <ImageView android:id="@+id/iv_app_icon" android:layout_width="44dp"
            android:layout_height="44dp"/>
        <ImageView android:id="@+id/iv_lock_icon" android:layout_width="18dp"
            android:layout_height="18dp" android:layout_gravity="bottom|end"
            android:src="@drawable/ic_lock_small" android:visibility="gone"/>
    </FrameLayout>

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/tv_app_name" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/text_primary"
            android:textSize="15sp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/tv_package_name" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textColor="@color/text_secondary"
            android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
    </LinearLayout>

    <Switch android:id="@+id/switch_lock" android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</LinearLayout>
